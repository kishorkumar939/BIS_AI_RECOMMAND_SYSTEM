# Backend environment variables
# Copy to .env and fill in values

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./bis_standards.db

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bis_standards

# Embedding model (HuggingFace)
# BGE-M3 produces 1024-dimensional vectors
# EMBEDDING_MODEL=BAAI/bge-m3

# Local LLM (GGUF format) — path to model file
# If not present, the engine falls back to template-based clause generation
LLM_MODEL_PATH=models/mistral-7b-instruct.Q4_K_M.gguf
