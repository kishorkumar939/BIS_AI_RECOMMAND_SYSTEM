{
  "manifest_version": 3,
  "name": "BIS Standards AI Assistant",
  "version": "1.0.0",
  "description": "Automatically maps procurement tender requirements to applicable Indian Standards (BIS) codes and compliance clauses.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://gem.gov.in/*",
    "https://eprocure.gov.in/*",
    "https://cppp.gov.in/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gem.gov.in/*",
        "https://eprocure.gov.in/*",
        "https://cppp.gov.in/*"
      ],
      "js": ["content.js"],
      "css": ["widget.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
